{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "buildCommand": "node scripts/build-public.mjs",
  "outputDirectory": "dist-public",
  "rewrites": [
    {
      "source": "/accedi",
      "destination": "/accedi.html"
    },
    {
      "source": "/studio",
      "destination": "/studio.html"
    },
    {
      "source": "/profilo",
      "destination": "/profilo.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/ordini",
      "destination": "/orders.html"
    },
    {
      "source": "/termini",
      "destination": "/termini.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/cookie",
      "destination": "/cookie.html"
    },
    {
      "source": "/rimborsi",
      "destination": "/rimborsi.html"
    },
    {
      "source": "/recesso",
      "destination": "/recesso.html"
    }
  ]
}
